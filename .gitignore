# Generated outputs — never commit auto-generated images or processed inputs
mj-output/
prompts-inbox/processed/

# MJ watcher runtime state — per-prompt done markers + in-flight lockfile.
# The other watchers' lockfiles live in their own inbox dirs; same pattern
# (chart-inbox/.processing-*, reel-inbox/.processing-*, etc.) are covered by
# `*/processed/` since they move out on completion. The MJ watcher's markers
# stay in place until the whole pack finishes, so they need explicit rules.
prompts-inbox/.mj-done-*
prompts-inbox/.processing-*

# Local free-model test renders (pollinations / draw-things)
free-output/

# FLUX.2 local model weights (22GB) + generated renders — never commit
assets/flux2/FLUX.2-klein-4B/
assets/flux2/*.png
assets/flux2/*/
lib/flux2-renderer/.venv/
lib/flux2-renderer/__pycache__/

# ad-hoc media-gen output (agent experiments)
output.md

# CLIP sample catalog (generated by `npm run clip:samples`)
data/clip/

# Audio-inbox test artifacts (e2e songs processing)
audio-inbox/processed/

# Reel-inbox test artifacts (e2e reel processing)
reel-inbox/processed/
# Instagram posted reels (moved after successful post)
reel-inbox/posted/

# Chart export artifacts (e2e tests leave these in chart-inbox/)
chart-inbox/*.pdf
chart-inbox/*.mp3
chart-inbox/*.mid
chart-inbox/*_Whole/
chart-inbox/*_PDF/
chart-inbox/*_No_Sax/
chart-inbox/*_No_Trumpet/
chart-inbox/processed/

# Songs catalogs (auto-generated)
data/songs/catalog.json
data/songs/catalog-jazz-solos.json

# Logs
logs/*.log
logs/*.out.log
logs/*.err.log
logs/*.gz

# OS junk
.DS_Store

# e2e artifacts and dependencies
e2e/artifacts/
e2e/node_modules/

# Environment
.env
.env.local

# Vercel
.vercel/

# Worktrees (other sessions working in this repo)
.worktrees/

# Agent loop state
.agent/

# Midjourney cookie jars — SECRET (session tokens). Never commit.
*.midjourney-cookies.txt
mj-cookies*.txt
*-cookies.txt
# Kai project memory (local-only by choice — contains absolute paths)
.kai/

# CLIP Interrogator venv (uv-managed, generated)
lib/clip-interrogator/.venv/

# uv build artifacts
lib/clip-interrogator/dist/

# Loopable Video Segmenter venv (uv-managed, generated)
lib/loopable-video-segmenter/.venv/

# uv build artifacts
lib/loopable-video-segmenter/dist/


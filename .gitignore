# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/

# Node
node_modules/
npm-debug.log*

# Test artifacts (regenerated by landing.spec.mjs)
e2e/artifacts/

# Runtime logs (launchd server / boot / launchd err logs)
logs/

# Chart-watcher auto-generated outputs (PDFs / MP3s / MIDI / processed/)
# Keep the inbox itself + .gitkeep so the dir exists in the repo.
chart-inbox/*
!chart-inbox/.gitkeep

# Songs-watcher auto-generated catalog (data/songs/catalog.json is
# indexer output; safe to delete + regenerate via npm run index-songs
# or the songs-watcher LaunchAgent).
data/songs/catalog.json

# Songs-watcher audio-inbox (drop zone + processed/)
audio-inbox/*
!audio-inbox/.gitkeep

# Environment
.env
.env.local
